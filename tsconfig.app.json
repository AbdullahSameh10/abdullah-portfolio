{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "ignoreDeprecations": "6.0",

    "baseUrl": "./src",

    "paths": {
      "@/*": ["*"],

      "@Assets/*": ["assets/*"],
      "@Components/*": ["components/*"],
      "@Layouts/*": ["layouts/*"],
      "@Pages/*": ["pages/*"],
      "@Hooks/*": ["hooks/*"],
      "@Utils/*": ["utils/*"],
      "@Data/*": ["data/*"],
      "@Context/*": ["context/*"],
      "@Types/*": ["types/*"],
      "@Services/*": ["services/*"],
      "@Styles/*": ["styles/*"],
      "@Locales/*": ["locales/*"],
      "@I18n/*": ["i18n/*"]
    },

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    "jsx": "react-jsx",

    "strict": true
  },

  "include": ["src"]
}
